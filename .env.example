# Copy this file to .env and fill in your values.
# .env is git-ignored; command-line flags override anything set here.

# Required. In Docker next to Jellyfin, prefer the internal address, e.g.
# http://jellyfin:8096 (see compose.override.example.yaml)
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=your-api-key-here

# Seerr, for the Requests tab (leave out to skip it)
SEER_URL=http://192.168.1.10:5055
SEER_API_KEY=your-api-key-here
# Only if a reverse proxy in front of Seerr asks for a client certificate (PEM files):
# SEER_CLIENT_CERT=C:/certs/client.pem
# SEER_CLIENT_KEY=C:/certs/client.key

# Optional
# EXPORT_TITLE="My collection"
# EXPORT_OUTPUT=collection.html
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
# JELLYFIN_USER_ID=
# EXPORT_CA_CERT=C:/certs/home-ca.pem   # trust a self-signed Jellyfin / Seerr certificate
# JELLYFIN_INSECURE=1              # last resort: no certificate checks at all
# EXPORT_CACHE_DIR=.marqueefin_cache
# EXPORT_POSTER_FORMAT=webp       # or jpeg (Jellyfin's default format)
# EXPORT_PARALLEL_PAGES=4         # Jellyfin result pages fetched at the same time
# EXPORT_TITLE_LANGUAGE=de        # titles in a second language too (de, fr, pt-BR, ...; needs Seerr)
# EXPORT_MAIN_LANGUAGES=en,de     # languages always shown as flags (default: en + the title language)
# EXPORT_REFRESH=1                # ignore what's remembered from earlier runs, once
# A passphrase friends type to open the page (the library is sealed until then):
# EXPORT_PASSPHRASE="four random words here"
# EXPORT_PASSPHRASE_FILE=/run/secrets/page_passphrase   # or read it from a file

# Docker only (see docker/README.md)
# SCHEDULE="15 5 * * *"        # cron syntax; empty = run once and exit
# TZ=Europe/Berlin               # your time zone (default UTC)
# RUN_ON_START=1               # also run right after the container starts
# HEALTH_MAX_AGE_HOURS=26       # unhealthy when the last good run is older
# EXPORT_ARGS="--workers 8"    # extra flags for the exporter

# Upload over SFTP (leave UPLOAD_HOST out to keep the page in the volume only)
# UPLOAD_HOST=web.example.com
# UPLOAD_PORT=22
# UPLOAD_USER=marqueefin
# UPLOAD_DIR=/library           # the web folder, as the upload account sees it
# UPLOAD_FILENAME=index.html

# Gotify notification when a run fails (and a quieter one when it skipped something)
# GOTIFY_URL=https://gotify.example.com
# GOTIFY_TOKEN=application-token   # Gotify > Apps > create an application
